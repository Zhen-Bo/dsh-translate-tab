{
  "name": "dsh-translate-tab",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: a Translate entry under Plugins in the sidebar that swaps the main area for a two-pane translator with model, effort and prompt controls.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "translate",
    "translation",
    "i18n"
  ],
  "homepage": "https://github.com/Zhen-Bo/dsh-translate-tab#readme",
  "bugs": {
    "url": "https://github.com/Zhen-Bo/dsh-translate-tab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhen-Bo/dsh-translate-tab.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "typecheck": "tsc",
    "lint": "gts lint",
    "fix": "gts fix && prettier --write \"**/*.{css,json}\"",
    "test": "vitest run",
    "check": "tsc && gts lint && vitest run && node scripts/build.ts",
    "preversion": "npm run check",
    "version": "node scripts/changelog.ts release && git add CHANGELOG.md",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "gts": "^7.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9",
    "vitest": "^5.0.3"
  }
}
